# ==============================================================
# Faraz Khan Portfolio - Environment Variables Configuration
# ==============================================================
#
# Duplicate this file as .env.local to configure real email delivery:
#   cp .env.example .env.local
#

# The email address where messages sent through the contact form will be delivered:
CONTACT_RECEIVER_EMAIL=faraz.khan@example.com

# --------------------------------------------------------------
# RESEND (Recommended Provider - 3000 free emails/month)
# Sign up free at https://resend.com and grab your API key
# --------------------------------------------------------------
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Verified sender email in Resend (default works for testing to your account email):
RESEND_FROM_EMAIL=Faraz Portfolio <onboarding@resend.dev>

# --------------------------------------------------------------
# Public Site Configuration (Optional for Canonical SEO)
# --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://farazkhan.dev
